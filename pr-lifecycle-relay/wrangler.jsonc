// Reference only: the relay is not deployed (#29 Part B). Values in angle brackets are placeholders.
{
  "name": "pr-lifecycle-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "LIFECYCLE", "class_name": "LifecycleObject" },
      { "name": "GRANTS", "class_name": "GrantStore" },
      { "name": "REPO_INDEX", "class_name": "RepoIndex" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LifecycleObject"] },
    { "tag": "v2", "new_sqlite_classes": ["GrantStore", "RepoIndex"] }
  ],
  "vars": { "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com", "ACCESS_AUD": "<aud tag>" }
}
