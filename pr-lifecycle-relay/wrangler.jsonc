// Reference only (#29 Part B): values in angle brackets are placeholders. The development deploy uses a copy of this with its own name
// and vars (README, "The development deploy").
{
  "name": "pr-lifecycle-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      { "name": "LIFECYCLE", "class_name": "LifecycleObject" },
      { "name": "GRANTS", "class_name": "GrantStore" },
      { "name": "REPO_INDEX", "class_name": "RepoIndex" },
      { "name": "WORK", "class_name": "WorkBoard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LifecycleObject"] },
    { "tag": "v2", "new_sqlite_classes": ["GrantStore", "RepoIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkBoard"] }
  ],
  "vars": { "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com", "ACCESS_AUD": "<aud tag>", "ADMINS": "<comma-separated admin people>" }
}
